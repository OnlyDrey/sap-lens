# Native Windows/Linux defaults. Never put a secret value here.
SAP_LENS_DEPLOYMENT_MODE=server
SAP_LENS_HOST=127.0.0.1
SAP_LENS_PORT=18743
SAP_LENS_DATA_DIR=/var/lib/sap-lens
SAP_LENS_SOURCE_DIR=/srv/sap-lens-sources
SAP_LENS_PUBLIC_ORIGIN=http://127.0.0.1:18743
SAP_LENS_ALLOWED_HOSTS=127.0.0.1
SAP_LENS_AUTH=sessions
SAP_LENS_LOG_LEVEL=info
# Account activation is issued locally: server.py --identity-code --data-directory ABS
# For a trusted TLS-terminating proxy only:
# SAP_LENS_AUTH_SECRET_FILE=/etc/sap-lens/access.secret
# SAP_LENS_TRUSTED_PROXIES=127.0.0.1/32

# Required before encrypted backups/migrations; private file outside the data root.
# SAP_LENS_BACKUP_KEY_FILE=/etc/sap-lens/backup.key
# SAP_LENS_BACKUP_KEY_GROUP_READ=1
