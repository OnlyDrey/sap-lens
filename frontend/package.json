{
  "name": "sap-role-checker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "dev:backend": "cd ../backend && python -m uvicorn main:app --host 127.0.0.1 --port 18744 --reload",
    "test:browser": "playwright test",
    "check:types": "tsc --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-scroll-area": "^1.0.5",
    "@tanstack/react-query": "^5.0.0",
    "clsx": "^2.1.0",
    "lucide-react": "^0.363.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwind-merge": "^2.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.4.0",
    "concurrently": "^10.0.6",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.2.0",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": ">=24 <26"
  }
}
