<Project Sdk="Microsoft.NET.Sdk">

  <!-- Windows Desktop shell: WinForms + WebView2 hosting the shared ASP.NET Core core in-process on loopback. Cross-compiled on Linux
       (EnableWindowsTargeting); it runs only on Windows. Not a replacement of the production v1 launcher or installer. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <!-- `dotnet publish -c Release` alone produces the complete package: one self-contained exe; the UI is embedded in SapLens.Api.dll inside it. -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <AssemblyName>SapLens2Prototype</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- SapLens.Api is also the Server executable; Desktop uses it as a library. -->
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SapLens.Api\SapLens.Api.csproj" />
  </ItemGroup>

  <!-- The WebView2 package always references its WPF control; this WinForms app does not use WPF (avoids a WindowsBase version conflict). -->
  <Target Name="DropWebView2Wpf" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>

</Project>
