<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The production React UI (frontend/, the same sources as origin/work) and the server's sign-in page are compiled into this assembly, so every host
         (Server, Desktop single-file, tests) serves the same files regardless of working directory or publish layout. Each file is a manifest resource
         named "SapLensUi/<relative path>" (explicit LogicalName), served by UiAssets/EmbeddedUiFileProvider. The embedded-files manifest
         (GenerateEmbeddedFilesManifest) is not used: it splits paths on the build machine's separator only and can stay stale across incremental
         builds, which broke Windows release builds. -->
    <!-- Overridable only so the build-integration tests can embed a synthetic dist from a temporary folder. -->
    <SapLensFrontendRoot Condition="'$(SapLensFrontendRoot)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../../../frontend'))</SapLensFrontendRoot>
    <SapLensFrontendDist>$(SapLensFrontendRoot)/dist</SapLensFrontendDist>
  </PropertyGroup>

  <!-- Windows Server package: one self-contained single-file SapLens.Api.exe. Native libraries (SQLite's e_sqlite3.dll) stay next to the exe instead of
       being extracted to %TEMP% at startup, which a Windows service account may not be allowed to use. No trimming, Native AOT or compression (not
       validated). No IIS web.config: the Server is not hosted by IIS. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishAot>false</PublishAot>
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
  </PropertyGroup>

  <!-- Not used by this self-hosted (Kestrel) server: the IIS in-process module and the static web assets endpoint manifest (the UI is embedded). -->
  <Target Name="DropUnusedServerFiles" AfterTargets="ComputeResolvedFilesToPublishList" Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Filename)%(Extension)' == 'aspnetcorev2_inprocess.dll'" />
    </ItemGroup>
  </Target>
  <!-- The static web assets SDK copies its endpoint manifest after the publish list is computed; the server never reads it (the UI is embedded). -->
  <Target Name="DropStaticWebAssetsManifest" AfterTargets="Publish">
    <Delete Files="$(PublishDir)$(TargetName).staticwebassets.endpoints.json" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="wwwroot\**" />
    <!-- Embedded below; never published as loose files. -->
    <Content Remove="V1Reference\**" />
    <EmbeddedResource Include="wwwroot\**" LogicalName="SapLensUi/%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- Reference data exported from Python v1 by tools/export_v1_reference.py; read by the v1 compatibility API, not served as files. -->
    <EmbeddedResource Include="V1Reference\*.json;V1Reference\*.xlsx" LogicalName="V1Reference.%(Filename)%(Extension)" ExcludeFromManifest="true" />
  </ItemGroup>

  <!-- Frontend: built with the repository's own npm scripts when dist is missing, or always with -p:BuildFrontend=true (release builds). Node.js is a
       build-time requirement only; nothing of it ships. -->
  <Target Name="SapLensBuildFrontend" BeforeTargets="AssignTargetPaths" Condition="'$(BuildFrontend)' == 'true' Or !Exists('$(SapLensFrontendDist)/index.html')">
    <Error Condition="!Exists('$(SapLensFrontendRoot)/package.json')" Text="The React frontend was not found at $(SapLensFrontendRoot)." />
    <Message Importance="high" Text="Building the React frontend in $(SapLensFrontendRoot)" />
    <Exec Command="npm ci --no-audit --no-fund" WorkingDirectory="$(SapLensFrontendRoot)" Condition="'$(BuildFrontend)' == 'true' Or !Exists('$(SapLensFrontendRoot)/node_modules')" />
    <Exec Command="npm run build" WorkingDirectory="$(SapLensFrontendRoot)" />
  </Target>

  <!-- Adds frontend/dist to the embedded resources before resource names are assigned. RecursiveDir uses the build machine's separator; the provider
       normalizes it, so Windows and Linux builds embed the same layout. The list of embedded UI names is a CoreCompile input: adding or removing a UI file
       always rebuilds the assembly, also in incremental builds where no file became newer. -->
  <Target Name="SapLensEmbedFrontend" BeforeTargets="AssignTargetPaths;PrepareResourceNames" DependsOnTargets="SapLensBuildFrontend">
    <Error Condition="!Exists('$(SapLensFrontendDist)/index.html')" Text="frontend/dist/index.html is missing after the frontend build." />
    <ItemGroup>
      <_SapLensFrontendFiles Include="$(SapLensFrontendDist)/**/*" />
      <EmbeddedResource Include="@(_SapLensFrontendFiles)" LogicalName="SapLensUi/%(RecursiveDir)%(Filename)%(Extension)" />
      <_SapLensUiNames Include="@(EmbeddedResource->'%(LogicalName)')" Condition="$([System.String]::Copy('%(EmbeddedResource.LogicalName)').StartsWith('SapLensUi/'))" />
    </ItemGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)SapLensUi.files" Lines="@(_SapLensUiNames)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <CustomAdditionalCompileInputs Include="$(IntermediateOutputPath)SapLensUi.files" />
      <FileWrites Include="$(IntermediateOutputPath)SapLensUi.files" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\SapLens.Application\SapLens.Application.csproj" />
  </ItemGroup>

</Project>
