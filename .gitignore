# Environment / secrets
.env
.env.*
!.env.example

legacy/v1/backend/.env
frontend/.env

# Local backups
*.bak
*.backup
*.tmp

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
# Environments set aside by `build.ps1 -Mode prerequisites -Repair` (kept for inspection, never committed)
.venv.broken-*/

# PyInstaller (SAP Lens v1, archived under legacy/v1)
legacy/v1/backend/build/
legacy/v1/backend/dist/
legacy/v1/backend/*.spec

# .NET build output (backend/; nested .gitignore covers bin/obj)
/backend/artifacts/

# Node
node_modules/
frontend/node_modules/

# Frontend build
frontend/dist/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Coverage
coverage/
htmlcov/
.coverage
# Browser test artifacts
/frontend/test-results/
/frontend/playwright-report/
/frontend/blob-report/

# User-owned application data (generic fixtures remain versioned)
*.csv
!**/fixtures/*.csv
!examples/role-catalogue.example.csv
!examples/user-access.example.csv
!examples/employee-directory.example.csv
# The validation tracker lists expected behavior only (no SAP data) and is the source of truth for the review workflow
!docs/validation/validation-items.csv
**/settings.json
**/classification-profiles.json
**/import-profiles.json
**/runtime.json
/local-config/
/app-data/
/user-branding/
/configuration-backups/
*.sap-lens.json
!examples/synthetic-profile.sap-lens.json

# Compiler and diagnostic exports
*.tsbuildinfo
SAP-Lens-diagnostics*.json

# Private imported Employee Directory snapshots (never build inputs)
**/employee-directory/

# Private account review annotations
**/account-review.json

**/saved-filters.json

# Local canonical CSV snapshots and private refresh evidence
**/csv-data/

*.secret

# Private SoD annotations and review indexes
sod-catalogue.json
sod-reviews.json
sod-periods.json

# Local validation reports, traces and synthetic browser artifacts
/build/validation/
/build/test-artifacts/
# Native verification commands write these reports directly under build/.
/build/scm-*.json
/build/service-auth-*.json

# Every generated distributable (legacy/v1/scripts/build_system/layout.py): local, deployment, server, publication, versioned outputs and the cleanup lock
/dist/

# Verified project-local build tools (never release inputs)
.build-tools/

# TLS material and secret files (never committed; documentation and tests use reserved example values or generate keys at run time)
*.pfx
*.p12
*.key
*.pem
*.crt
*.cer
*.der
*.jks
cert-password
api-token
# Runtime databases (SQLite and its WAL/SHM side files)
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.db
*.db-wal
*.db-shm
# Machine-specific configuration (templates such as start-server-test.example.json stay versioned)
*.local.json
*.local.psd1
# Local deny list for scripts/check-secrets.py (personal hostnames, addresses or names; never committed)
.secret-scan.local

# Synthetic SAP Lens 2 test fixtures generated by tools (reserved-domain data, synthetic secrets only). They mirror the private v1 file layout that
# the rules above keep out of the repository for real installations, so only these exact fixture paths are re-included.
!backend/tests/SapLens.Tests/Fixtures/v1-data/**
!backend/tests/SapLens.Tests/Fixtures/v1-data/data/csv-data/
!backend/tests/SapLens.Tests/Fixtures/accounts/build-970d219/accounts.sqlite3
