/frontend/blob-report/

# User-owned application data (generic fixtures remain versioned)
*.csv
!**/fixtures/*.csv
!examples/role-catalogue.example.csv
!examples/user-access.example.csv
!examples/employee-directory.example.csv
# The validation tracker lists expected behavior only (no SAP data) and is the source of truth for the review workflow
!docs/validation/validation-items.csv
**/settings.json
**/classification-profiles.json
**/import-profiles.json
**/runtime.json
/local-config/
/app-data/
/user-branding/
/configuration-backups/
*.sap-lens.json
!examples/synthetic-profile.sap-lens.json

# Compiler and diagnostic exports
*.tsbuildinfo
SAP-Lens-diagnostics*.json

# Private imported Employee Directory snapshots (never build inputs)
**/employee-directory/

# Private account review annotations
**/account-review.json

**/saved-filters.json

# Local canonical CSV snapshots and private refresh evidence
**/csv-data/

*.secret

# Private SoD annotations and review indexes
sod-catalogue.json
sod-reviews.json
sod-periods.json

# Local validation reports, traces and synthetic browser artifacts
/build/validation/
/build/test-artifacts/
# Native verification commands write these reports directly under build/.
/build/scm-*.json
/build/service-auth-*.json

# Every generated distributable (scripts/build_system/layout.py): local, deployment, server, publication, versioned outputs and the cleanup lock
/dist/

# Verified project-local build tools (never release inputs)
.build-tools/
